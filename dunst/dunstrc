[global]
    monitor = 0
    follow = mouse

    origin = top-center
    offset = 10x40
    width = (300, 500)
    height = 300
    gap_size = 6
    corner_radius = 10
    frame_width = 2
    frame_color = "#89b4fa"
    separator_color = frame

    padding = 12
    horizontal_padding = 14
    text_icon_padding = 10

    font = Monaspace Argon Medium 11
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    ellipsize = middle
    show_age_threshold = 60

    icon_position = left
    max_icon_size = 48

    progress_bar = true
    progress_bar_height = 10
    progress_bar_frame_width = 1
    progress_bar_corner_radius = 4

    sticky_history = yes
    history_length = 20

    mouse_left_click = do_action, close_current
    mouse_middle_click = close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#89b4fa"
    timeout = 5

[urgency_normal]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#89b4fa"
    timeout = 8

[urgency_critical]
    background = "#1e1e2e"
    foreground = "#f38ba8"
    frame_color = "#f38ba8"
    timeout = 0
