#!/usr/bin/env sh

# --- keyboard: Brazilian ABNT2, ThinkPad/Lenovo model, no extra options ---
setxkbmap -model thinkpad60 -layout br -variant abnt2 -option ""

# --- dark mode (GTK3/GTK4/libadwaita apps, matching Ubuntu's look) ---
# needs gtk-3.0/, gtk-4.0/, and rofi/ symlinked into ~/.config like the others
export GTK_THEME=Adwaita:dark
gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark' 2>/dev/null

# polybar's colors.ini reads ${xrdb:colorN} -- must run before monitors.sh
# launches polybar. GDM's bspwm session doesn't go through /etc/X11/xinit's
# usual xrdb-merge step, so it's done here instead.
xrdb -merge ~/.config/Xorg/Xresources

# --- monitors: laptop panel + optional ultrawide external, plus the
# matching bspwm desktop split and polybar instance count -- all three are
# handled together by monitors.sh so they can't drift out of sync. Run
# synchronously (no &) so desktops/polybar exist before the config below.
~/.config/Xorg/scripts/monitors.sh

# --- input tuning (cursor theme, tap-to-click, pointer speed) ---
~/.config/Xorg/scripts/input-setup.sh

# --- autostart ---
# guard against duplicates piling up across `bspc wm -r` restarts
pkill -x sxhkd
pkill -x picom
sxhkd &
picom --config ~/.config/Xorg/picom/picom.conf &
# dunst is systemd/D-Bus-activated on this machine (org.freedesktop.Notifications
# -> dunst.service), not started here -- config still applies from
# ~/.config/dunst/dunstrc regardless of how it's launched. Symlink dunst/
# into ~/.config, then `systemctl --user restart dunst.service` after
# editing dunstrc.
feh --bg-fill /usr/share/backgrounds/Rainbow_lightbulb_by_Daniel_Micallef.png

# airplane-mode notification (the key itself is handled by firmware, see script)
pkill -f rfkill-notify.sh
~/.config/Xorg/scripts/rfkill-notify.sh &

# re-applies monitors.sh automatically on hotplug, instead of only reacting
# to the manual super+shift+m hotkey
pkill -f monitor-watch.sh
~/.config/Xorg/scripts/monitor-watch.sh &

# 3-finger swipe to switch desktops (config: ~/.config/libinput-gestures.conf —
# symlink libinput-gestures/config from this repo to that exact file, it's
# flat, not a directory like the others). Run directly rather than through
# `libinput-gestures-setup start`: that wrapper only knows how to launch
# itself via a KDE/GNOME/i3-style desktop launcher, none of which apply to
# bspwm, so it silently no-ops here regardless of whether it's installed.
pkill -f libinput-gestures
command -v libinput-gestures >/dev/null 2>&1 && libinput-gestures &

# lock after 5 minutes of inactivity, then blank the display shortly after
xautolock -time 5 -locker "$HOME/.config/Xorg/scripts/lock.sh" -detectsleep &
xset s off -dpms
xset dpms 300 0 0     # screen off 5 min after the lock (adjust to taste)


# --- window rules ---
bspc rule -a ghostty.floating state=floating center=true rectangle=1200x800+200+200
bspc rule -a ghostty.impala  state=floating center=true rectangle=1200x800+200+200
bspc rule -a ghostty.bluetui state=floating center=true rectangle=1200x800+200+200
bspc rule -a ghostty.wiremix state=floating center=true rectangle=1200x800+200+200
bspc rule -a ghostty.yazi state=floating center=true rectangle=1200x800+200+200
bspc rule -a lazydocker.floating state=floating center=true rectangle=1500x800+200+200
bspc rule -a Gnome-calculator state=floating center=true rectangle=1200x800+200+200

# --- bspwm config ---
bspc config border_width         1
bspc config top_padding          0
bspc config window_gap           2
bspc config split_ratio          0.52
bspc config borderless_monocle   true
bspc config gapless_monocle      true
bspc config focus_follows_pointer true

# super + left-drag: move, super + middle/right-drag: resize
bspc config pointer_modifier super
bspc config pointer_action1 move
bspc config pointer_action2 resize_corner
bspc config pointer_action3 resize_corner

bspc config remove_disabled_monitors true
bspc config remove_unplugged_monitors true
bspc config merge_overlapping_monitors true
